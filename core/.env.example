ENVIRONMENT=development
DB_CREATE_DROP=false

DATABASE_URL=postgresql+asyncpg://threadfs:threadfs@localhost:5432/thread_fs_db

CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_COMMENT_CREATE_PER_MINUTE=5
RATE_LIMIT_COMMENT_EDIT_PER_HOUR=20
RATE_LIMIT_COMMENT_DELETE_PER_HOUR=20
RATE_LIMIT_VOTE_PER_MINUTE=60

# Optional, with their defaults (README › Capacity)
# REDIS_URL=redis://localhost:6379/0
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# MAX_COMMENT_LENGTH=10000
# COMMUNITY_CACHE_SECONDS=30
# READ_CACHE_SECONDS=5
