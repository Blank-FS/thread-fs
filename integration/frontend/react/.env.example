# Local config for the dev test site (src/main.tsx). Copy to .env and fill in.
# .env is gitignored, so each developer keeps their own values.
VITE_THREADFS_API_BASE_URL=http://localhost:8001
VITE_THREADFS_COMMUNITY_KEY=tfspub_demo_abc123
VITE_THREADFS_THREAD_ID=demo-thread
VITE_THREADFS_EXTERNAL_USER_ID=demo-user-1
# Signed JWT for the external user above. With a threadfs_role claim, comments get a Remove action
VITE_THREADFS_AUTH_TOKEN=
# Signed JWT with a threadfs_role claim, for the Moderation tab
VITE_THREADFS_MODERATOR_TOKEN=
